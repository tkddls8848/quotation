{
  "name": "quotation-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "worker:dev": "wrangler dev --env=\"\"",
    "check": "wrangler deploy --dry-run --env=\"\" --outdir .wrangler/dry-run",
    "deploy": "wrangler deploy --env=\"\""
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.123.0"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  }
}
