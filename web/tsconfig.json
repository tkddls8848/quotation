{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // vite.config.ts 가 node:url 을 쓴다. 설정 파일도 같은 프로그램에 든다.
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    // 도구는 최상위 기능 폴더에 있다. 셸에서 그쪽으로 가는 별명만 둔다
    // (도구끼리는 서로를 부르지 않는다).
    "paths": {
      "@quotation/*": ["../quotation/web/src/*"],
      "@fire/*": ["../fire/web/src/*"],
      // 화면이 아니라 Worker 쪽 진입점. wrangler.jsonc 의 alias 와 짝이다.
      "@fire/worker/*": ["../fire/worker/*"],
      "@converters/*": ["../converters/web/src/*"],
      // 도구의 테스트는 제 폴더에 있지만 vitest 는 셸에 깔린다. 그 자리를 알려 준다.
      "vitest": ["./node_modules/vitest"],
      "pdf-lib": ["./node_modules/pdf-lib"]
    },
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "noEmit": true
  },
  // Worker 스크립트(worker/, ../fire/worker/)도 같은 프로그램에 든다. wrangler 가
  // 따로 묶어 내보내지만 타입 검사까지 나뉘면 배포 뒤에야 오류를 안다.
  "include": [
    "src",
    "worker",
    "vite.config.ts",
    "../quotation/web/src",
    "../fire/web/src",
    "../fire/worker",
    "../converters/web/src"
  ]
}
