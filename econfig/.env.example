# IBM SSO 비밀번호나 cookie를 저장하지 마십시오.
# e-config에서 정식으로 허용된 JWT만 프로세스 환경에 주입합니다.
IBM_ECONFIG_JWT=
IBM_ECONFIG_BASE_URL=https://www.ibm.com/services/econfigcloud/api
IBM_ECONFIG_USER_NAME=SYSTEM
IBM_ECONFIG_USER_TYPE=business-partner
IBM_ECONFIG_USER_COUNTRY=KR
IBM_ECONFIG_USER_ROLE=business-partner
IBM_ECONFIG_LANGUAGE=ko-KR
IBM_ECONFIG_ENCODE_BODY=false
IBM_ECONFIG_TIMEOUT_SECONDS=60

